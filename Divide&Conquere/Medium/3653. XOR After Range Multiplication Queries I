class Solution {
public:
    int xorAfterQueries(vector<int>& nums, vector<vector<int>>& queries) {
        int Xor=0,idx;
        long long MOD = 1e9 + 7;
        for(int i=0 ; i<queries.size() ; i++){
            idx = queries[i][0];
            while(idx<=queries[i][1]){
                nums[idx] =( (long long) nums[idx] * queries[i][3] ) % MOD ;
                idx += queries[i][2];
            }
        }
        for(int x : nums){
            Xor= Xor ^ x;
        }
        return Xor;
    }
};


