class Solution {
public:
    vector<int> concatWithReverse(vector<int>& nums) {
        vector<int> ans;
        int n=nums.size();

        if(n==0){
            return ans;
        }
        for(int el: nums){
            ans.push_back(el);
        }

        for(int i=0; i<n; i++){
            ans.push_back(nums[n-i-1]);
        }

        return ans;
    }
};