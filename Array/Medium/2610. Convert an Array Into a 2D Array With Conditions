class Solution {
public:
    vector<vector<int>> findMatrix(vector<int>& nums) {
        vector<vector<int>> ans;
        
        vector<int> freq(201, 0);

        for (int x : nums) {
            int row = freq[x];

            if (row == ans.size()) {
                ans.push_back({});
            }

            ans[row].push_back(x);

            freq[x]++;
        }

        return ans;
    }
};