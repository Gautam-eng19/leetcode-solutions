/**
 * Definition for singly-linked list.
 * struct ListNode {
 *     int val;
 *     ListNode *next;
 *     ListNode() : val(0), next(nullptr) {}
 *     ListNode(int x) : val(x), next(nullptr) {}
 *     ListNode(int x, ListNode *next) : val(x), next(next) {}
 * };
 */
class Solution {
public:
    ListNode* mergeInBetween(ListNode* list1, int a, int b, ListNode* list2) {
        if(list1 == NULL){
            return list1;
        }
        ListNode* n1 = list1;
        ListNode* n2 = list1;
        int count=1;
        while(count<a){
            count++;
            n1 = n1->next;
        }

        count=0;
        while(count<b){
            count++;
            n2 = n2->next;
        }
        ListNode* temp = list2;
        while(temp->next!=NULL){
            temp = temp->next;
        }

        n1->next = list2;
        
        temp->next = n2->next;

        return list1;
    }
};