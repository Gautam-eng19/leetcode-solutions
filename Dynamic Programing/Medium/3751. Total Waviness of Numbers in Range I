class Solution {
public:

    int waviness(int x){
        int ans=0;
        int right = x%10;
        x/=10;
        int mid = x%10;
        x/=10;

        while(x>0){
            int left = x%10;
            x/=10;

            if(mid>right && mid>left || mid<left && mid < right){
                ans++;
            } 

            right = mid;
            mid = left;
        }
        return ans;
    }

    int totalWaviness(int num1, int num2) {
        int ans=0;
        for(int i=num1 ; i<=num2 ; i++){
            if(i/100>0){
                ans+=waviness(i);
            }
        }
        return ans;
    }
};