class Solution {
public:

    int waviness(int x){
        vector<int>dp;
        while(x>0){
            dp.push_back(x%10);
            x/=10;
        }
        if(dp.size()<3){
            return 0;
        }
        int ans=0;
        for(int i=1 ; i<dp.size()-1 ; i++){
            if(dp[i]>dp[i-1] && dp[i]>dp[i+1] || dp[i]<dp[i-1] && dp[i]<dp[i+1]){
                ans++;
            }
        }

        return ans;
    }

    int totalWaviness(int num1, int num2) {
        int ans=0;
        for(int i=num1 ; i<=num2;i++){
            ans+=waviness(i);
        }
        return ans;
    }
};


