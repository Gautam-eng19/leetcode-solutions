class Solution {
public:
    int smallestNumber(int n, int t) {
        int prod=1,ans;
        for(int i=n;;i++){
            int num = i;
            while(num>0){
                prod*=num%10;
                num/=10;
            }
            if(prod%t==0){
                ans = i;
                break;
            }
            prod=1;
        }
        return ans;
    }
};