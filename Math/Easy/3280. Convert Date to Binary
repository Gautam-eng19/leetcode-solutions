class Solution {
public:
    string binaryconverter(string str){
        int num = stoi(str);
        if(num==0) return "0";

        string ans = "";
        while(num>0){
            ans+=(num%2)+'0';
            num/=2;
        }
        reverse(ans.begin(),ans.end());
        return ans;
    }
    string convertDateToBinary(string date) {
        int n = date.size();
        string str="";
        string ans="";
        for(int i=0;i<n;i++){
            if(date[i]=='-'){
                ans+= binaryconverter(str);
                ans+='-'; 
                str="";
            }
            else   
            str+=date[i];
        }
        ans+=binaryconverter(str);
        return ans;
    }
};