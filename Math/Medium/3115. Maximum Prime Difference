class Solution {
public:

    bool isPrime(int n) {
        if(n < 2) return false;

        for(int i = 2; i * i <= n; i++) {
            if(n % i == 0)
            return false;
        }

        return true;
    }

    int maximumPrimeDifference(vector<int>& nums) {
        int n = nums.size();
        int l=-1,r=-1;
        for(int i=0;i<n;i++){
            if(l==-1 && isPrime(nums[i])){
                l=r=i;
            }
            else if(isPrime(nums[i])){
                r=i;
            }
        }
        return abs(r-l);
    }
};