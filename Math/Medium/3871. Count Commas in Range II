class Solution {
public:
    long long countCommas(long long n) {
        if (n <= 0) return 0;

        long long ans = 0;
        long long start = 1000;

        while (start <= n) {
            ans += n - start + 1;

            if (start > n / 1000)
                break;

            start *= 1000;
        }

        return ans;
    }

    long long countCommas(long long l, long long r) {
        return countCommas(r) - countCommas(l - 1);
    }
};