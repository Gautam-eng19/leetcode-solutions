class Solution {
public:
    int longestNiceSubarray(vector<int>& nums) {
        int l=0,r=0,m=0,n=nums.size(),ans=0;
        while(r<n){
            while((m & nums[r])!= 0){
                m^=nums[l];
                l++;
            }
            m|=nums[r];
            ans = max(ans,r-l+1);
            r++;    
        }
        return ans;
    }
};