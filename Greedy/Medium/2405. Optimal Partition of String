class Solution {
public:
    int partitionString(string s) {
        int ans = 1;
        int mask = 0;

        for (char ch : s) {
            int bit = ch - 'a';

            if (mask & (1 << bit)) {
                ans++;
                mask = 0;
            }

            mask |= (1 << bit);
        }

        return ans;
    }
};