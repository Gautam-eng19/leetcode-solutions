class Solution {
public:
    int missingMultiple(vector<int>& nums, int k) {
        unordered_map<int,int> map;
        for(int x : nums){
            map[x]++;
        }
        for(int i =1; ;i++){
            if(map.find(i*k)==map.end()){
                return i*k;
            }
        }
        return -1;
    }
};