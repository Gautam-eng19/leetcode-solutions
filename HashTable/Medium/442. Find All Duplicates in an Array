class Solution {
public:
    vector<int> findDuplicates(vector<int>& nums) {
        vector<int> ans;
        for(int i =0 ; i<nums.size();i++){
            int n = abs(nums[i]);
            int idx = n-1;

            if(nums[idx]<0){
                ans.push_back(n);
            }else{
                nums[idx] = -nums[idx];
            }

        }
        return ans;
    }
};