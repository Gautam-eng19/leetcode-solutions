class Solution {
public:
    int passwordStrength(string password) {
        int str=0,n=password.length();
        unordered_set<char>s;
        for(char x : password){
            s.insert(x);
        }
        for(auto it = s.begin(); it != s.end() ; it++){
            if(isdigit(*it)){
                str+=3;
            }
            else if(islower(*it)){
                str+=1;
            }
            else if(isupper(*it)){
                str+=2;
            }
            else{
                str+=5;
            }
        }
        return str;
    }
};