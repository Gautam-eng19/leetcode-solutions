class Solution {
public:
    int numSpecialEquivGroups(vector<string>& words) {
        
        set<string> groups;

        for (string word : words) {
            
            string even = "";
            string odd = "";

            for (int i = 0; i < word.size(); i++) {
                if (i % 2 == 0)
                    even += word[i];
                else
                    odd += word[i];
            }

            sort(even.begin(), even.end());
            sort(odd.begin(), odd.end());

            groups.insert(even + "#" + odd);
        }

        return groups.size();
    }
};