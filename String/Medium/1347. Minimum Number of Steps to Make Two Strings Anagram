class Solution {
public:
    int minSteps(string s, string t) {
        vector<int> freqS(26,0);
        vector<int> freqT(26,0);
        for(char c: s){
            freqS[c-'a']++;
        }
        for(char c: t){
            freqT[c-'a']++;
        }
        int ans =0;
        for(int i=0;i<26;i++){
            if(freqS[i]>freqT[i]){
                ans+= freqS[i]-freqT[i];
            }
        }
        return ans;
    }
};