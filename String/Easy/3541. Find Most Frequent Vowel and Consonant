class Solution {
public:
    int maxFreqSum(string s) {
        vector<int> freq(26, 0);

        for(char c: s){
            freq[c-'a']++;
        }

        int maxVowel=0;
        int maxConsonant=0;

        for(int i=0; i<26; i++){
            char ch='a'+i;

            if(ch=='a' || ch=='e' || ch=='i' || ch=='o' || ch=='u'){
                maxVowel=max(maxVowel, freq[ch-'a']);
            }
            else{
                maxConsonant=max(maxConsonant, freq[ch-'a']);
            }
        }

        return maxVowel+maxConsonant;
    }
};