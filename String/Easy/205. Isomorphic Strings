class Solution {
public:
    bool isIsomorphic(string s, string t) {
        if(s.size()!=t.size()){
            return false;
        }

        vector<int> sToT(256, -1);
        vector<int> tToS(256, -1);

        for(int i=0; i<s.size(); i++){
            if(sToT[s[i]]!=-1 && sToT[s[i]]!=t[i]){
                return false;
            }
            if(tToS[t[i]]!=-1 && tToS[t[i]]!=s[i]){
                return false;
            }
            
            sToT[s[i]]=t[i];
            tToS[t[i]]=s[i];
        }

        return true;
    }
};