class Solution {
public:
    int maxProduct(int n) {
        vector<int> arr;
        int product=1,num = n;
        while(num>0){
            arr.push_back(num%10);
            num/=10;
        }
        sort(arr.begin(),arr.end());
        return (arr[arr.size()-1]*arr[arr.size()-2]);    
    }
};